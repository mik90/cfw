load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel:rust.bzl", "miri_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "logging",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "iceoryx2",
        "serde",
        "testing",
    ],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "logging_unit_tests",
    crate = ":logging",
    crate_features = [
        "iceoryx2",
        "serde",
        "testing",
    ],
    deps = all_crate_deps(normal_dev = True),
)

miri_test(
    name = "logging_miri",
    slow = True,
    srcs = glob(["src/**/*.rs"]),
    rustc_flags = [
        "--cfg",
        'feature="serde"',
        "--cfg",
        'feature="testing"',
    ],
    deps = [
        "//task:task",
        "//task_graph:task_graph",
        "//testing:testing",
        "//task_macros:task_macros",
        "//simulation_executor:simulation_executor",
        "//live_executor:live_executor",
    ] + all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)

load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel:rust.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "task_cxx_codegen",
    srcs = glob(["src/**/*.rs"]),
    include_default_features = False,
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "task_cxx_codegen_unit_tests",
    crate = ":task_cxx_codegen",
    include_default_features = False,
    deps = all_crate_deps(normal_dev = True),
)

rust_binary(
    name = "task_cxx_bridge_gen",
    srcs = ["src/bin/task_cxx_bridge_gen.rs"],
    include_default_features = False,
    deps = [":task_cxx_codegen"],
)

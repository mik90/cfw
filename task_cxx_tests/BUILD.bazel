load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:rust.bzl", "rust_library", "rust_test")
load(
    "//bazel_task_graph:defs.bzl",
    "cfw_channel",
    "cfw_cxx_task",
    "cfw_publisher",
    "cfw_subscriber",
)

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cxx_impl",
    srcs = ["src/input_span.cpp"],
    hdrs = ["src/input_span.hpp"],
    include_prefix = "task_cxx_tests",
    deps = [
        ":input_span_probe_include",
        "//task_cxx:bridge/include",
        "//task_cxx:output_headers",
        "@cxx.rs//:core",
    ],
)

cfw_channel(
    name = "input_span_in",
    payload = "u64",
)

cfw_channel(
    name = "input_span_out",
    payload = "String",
)

cfw_subscriber(
    name = "input_span_value",
    channel = ":input_span_in",
    field = "value",
    keep_across_runs = False,
    kind = "span",
    queue_capacity = 4,
    trigger = True,
)

cfw_publisher(
    name = "input_span_report",
    channel = ":input_span_out",
    field = "report",
    kind = "output",
)

cfw_cxx_task(
    name = "input_span_probe",
    cxx_type = "InputSpanProbeTask",
    factory = "make_input_span_probe_task",
    headers = ["task_cxx_tests/src/input_span.hpp"],
    include_prefix = "task_cxx_tests",
    namespace = "cfw::task_cxx_tests",
    publishers = [":input_span_report"],
    subscribers = [":input_span_value"],
    implementation = ":cxx_impl",
)

rust_library(
    name = "task_cxx_tests",
    srcs = ["src/bazel_lib.rs"],
    deps = [":input_span_probe_rust"],
)

rust_test(
    name = "input_span_test",
    srcs = ["tests/input_span.rs"],
    deps = [
        ":task_cxx_tests",
        "//testing",
    ],
)

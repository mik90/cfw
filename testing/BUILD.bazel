load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel:rust.bzl", "miri_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "testing",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    compile_data = [":readme"],
    deps = all_crate_deps(normal = True),
)

filegroup(
    name = "readme",
    srcs = ["README.md"],
)

rust_test(
    name = "testing_unit_tests",
    crate = ":testing",
    deps = all_crate_deps(normal_dev = True),
)

miri_test(
    name = "testing_miri",
    slow = True,
    srcs = glob(["src/**/*.rs"]),
    data = [":readme"],
    deps = [
        "//task:task",
        "//task_graph:task_graph",
        "//simulation_executor:simulation_executor",
        "//logging:logging",
        "//task_macros:task_macros",
    ] + all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)

# Bazel-only example: task API crates are generated into bazel-out, so this
# package is not a Cargo workspace member.

load("//bazel:rust.bzl", "rust_library")
load(
    "//bazel_task_graph:defs.bzl",
    "cfw_channel",
    "cfw_custom_schedule",
    "cfw_fixed_schedule",
    "cfw_live_application",
    "cfw_pool",
    "cfw_publisher",
    "cfw_subscriber",
    "cfw_task",
)

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "task_impls",
    srcs = ["src/lib.rs"],
    deps = [
        ":counter_api",
        ":doubler_api",
        ":printer_api",
        ":pulse_api",
        "//examples/bazel_pools/messages",
        "//task",
        "//task_graph",
    ],
)

rust_library(
    name = "schedules",
    srcs = ["schedules.rs"],
    deps = ["//task_graph"],
)

cfw_channel(
    name = "counter_channel",
    channel_name = "counter",
    payload = "messages::Iox2",
    transport = "iceoryx2",
    deps = ["//examples/bazel_pools/messages"],
)

cfw_channel(
    name = "doubled_channel",
    channel_name = "doubled",
    payload = "messages::Value",
    deps = ["//examples/bazel_pools/messages"],
)

cfw_channel(
    name = "counter_event",
    channel_name = "counter_event",
    kind = "iox2_event",
    transport = "iceoryx2",
)

cfw_publisher(
    name = "counter_output",
    channel = ":counter_channel",
    field = "output",
    kind = "iox2_output",
    queue_capacity = 8,
)

cfw_publisher(
    name = "counter_notify",
    channel = ":counter_event",
    field = "notify",
    kind = "iox2_notifier",
)

cfw_subscriber(
    name = "doubler_input",
    channel = ":counter_channel",
    field = "input",
    keep_across_runs = False,
    kind = "iox2_input",
    queue_capacity = 8,
)

cfw_subscriber(
    name = "doubler_event",
    channel = ":counter_channel",
    field = "_event",
    kind = "iox2_event",
    queue_capacity = 8,
)

cfw_publisher(
    name = "doubler_output",
    channel = ":doubled_channel",
    field = "output",
    queue_capacity = 8,
)

cfw_subscriber(
    name = "printer_input",
    channel = ":doubled_channel",
    field = "input",
    keep_across_runs = True,
    queue_capacity = 1,
    trigger = True,
)

cfw_subscriber(
    name = "pulse_input",
    channel = ":counter_event",
    field = "event",
    kind = "iox2_event",
    queue_capacity = 8,
)

cfw_fixed_schedule(
    name = "counter_periodic",
    execution_duration = "1ms",
    periodic = "100ms",
)

cfw_custom_schedule(
    name = "doubler_interval",
    crate = ":schedules",
    function = "doubler",
)

cfw_task(
    name = "counter",
    publishers = [
        ":counter_output",
        ":counter_notify",
    ],
    rust_type = "task_impls::Counter",
    schedule = ":counter_periodic",
    implementation = ":task_impls",
)

cfw_task(
    name = "doubler",
    publishers = [":doubler_output"],
    rust_type = "task_impls::Doubler",
    schedule = ":doubler_interval",
    subscribers = [
        ":doubler_input",
        ":doubler_event",
    ],
    implementation = ":task_impls",
)

cfw_task(
    name = "printer",
    rust_type = "task_impls::Printer",
    subscribers = [":printer_input"],
    implementation = ":task_impls",
)

cfw_task(
    name = "pulse",
    rust_type = "task_impls::Pulse",
    subscribers = [":pulse_input"],
    implementation = ":task_impls",
)

cfw_pool(
    name = "control",
    tasks = [
        ":counter",
        ":doubler",
        ":printer",
        ":pulse",
    ],
    threads = 2,
    deps = [":task_impls"],
)

cfw_live_application(
    name = "live",
    pools = [":control"],
)

load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cxx.bzl", "cfw_cxx_bridge")
load("//bazel:rust.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cxx_impl",
    srcs = ["src/fizz_buzz.cpp"],
    hdrs = ["src/fizz_buzz.hpp"],
    include_prefix = "cxx_fizz_buzz",
    deps = [
        ":bridge/include",
        "//examples/cxx_fizz_buzz/messages:bridge/include",
        "//task_cxx:bridge/include",
        "//task_cxx:output_headers",
        "@cxx.rs//:core",
    ],
)

cfw_cxx_bridge(
    name = "bridge",
    src = "src/tasks.rs",
    include_prefix = "cxx_fizz_buzz",
    deps = [
        ":cxx_impl",
        "//examples/cxx_fizz_buzz/messages:bridge/include",
    ],
)

rust_library(
    name = "cxx_fizz_buzz",
    srcs = [":bridge/rust"],
    crate_root = ":bridge/rust",
    crate_features = ["cxx"],
    include_default_features = False,
    deps = all_crate_deps(normal = True) + [
        ":bridge",
        ":cxx_impl",
        "//examples/cxx_fizz_buzz/messages:cxx_fizz_buzz_messages",
        "//task_cxx:task_cxx",
        "@crates//:cxx-1.0.205",
    ],
    proc_macro_deps = ["//task_cxx_macros:task_cxx_macros"],
)

rust_test(
    name = "cxx_fizz_buzz_test",
    crate = ":cxx_fizz_buzz",
    crate_features = ["cxx"],
    include_default_features = False,
    deps = all_crate_deps(normal_dev = True),
)

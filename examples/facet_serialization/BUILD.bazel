load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel:rust.bzl", "miri_test", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "facet_serialization",
    srcs = ["src/main.rs"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "facet_serialization_test",
    crate = ":facet_serialization",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

miri_test(
    name = "facet_serialization_miri",
    slow = True,
    srcs = ["src/main.rs"],
    deps = [
        "//task:task",
        "//task_graph:task_graph",
        "//live_executor:live_executor",
        "//logging:logging",
        "//task_macros:task_macros",
    ] + all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)

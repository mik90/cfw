load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel:rust.bzl", "miri_test", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "live_executor",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["iceoryx2"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "live_executor_unit_tests",
    crate = ":live_executor",
    crate_features = ["iceoryx2"],
    deps = all_crate_deps(normal_dev = True),
)

miri_test(
    name = "live_executor_miri",
    slow = True,
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//task:task",
        "//task_graph:task_graph",
        "//task_macros:task_macros",
    ] + all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ),
)
